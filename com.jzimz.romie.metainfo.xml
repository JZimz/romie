<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.jzimz.romie</id>

  <name>ROMie</name>
  <summary>ROM Manager for Retro Handhelds</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.jzimz">
    <name>JZimz</name>
  </developer>

  <description>
    <p>
      ROMie is a desktop application for organizing and managing your retro game ROM library. It helps you import, tag, and sync your game collections to SD cards for portable retro gaming handhelds.
    </p>
    <p>
      Key features include automatic game identification using RetroAchievements, a flexible tagging system for creating custom playlists, and seamless syncing to SD cards with support for multiple device profiles including MiyooMini+, Onion OS, muOS, and Knulli.
    </p>
    <p>
      Whether you have hundreds of games across multiple systems or just want an easier way to manage your portable gaming library, ROMie streamlines the entire workflow from import to device.
    </p>
  </description>

  <launchable type="desktop-id">com.jzimz.romie.desktop</launchable>

